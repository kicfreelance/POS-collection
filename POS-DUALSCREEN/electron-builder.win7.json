{
  "appId": "com.possystem.dualscreen",
  "productName": "POS Dual Screen",
  "asar": false,
  "electronVersion": "22.3.27",
  "directories": {
    "output": "release/win7-8"
  },
  "files": [
    "!src/**/*",
    "!electron/**/*.ts",
    "!electron/tsconfig.json",
    "!.next/**/*",
    "!.pgdata/**/*",
    "!.env",
    "!.env.example",
    "!*.md",
    "!electron-builder*.json",
    "!tsconfig.json",
    "!tsconfig.tsbuildinfo",
    "!eslint.config.mjs",
    "!postcss.config.mjs",
    "!next.config.ts",
    "!next-env.d.ts",
    "!components.json",
    "!release/**/*"
  ],
  "extraResources": [
    { "from": ".next/standalone", "to": "standalone" },
    { "from": ".next/standalone/node_modules", "to": "standalone/node_modules" },
    { "from": ".next/static", "to": "standalone/.next/static" },
    { "from": "public", "to": "standalone/public" }
  ],
  "win": {
    "target": [{ "target": "nsis", "arch": ["x64"] }],
    "requestedExecutionLevel": "asInvoker"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "perMachine": false
  }
}
