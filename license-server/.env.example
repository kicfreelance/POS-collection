# ---------------------------------------------------------------------------
# Postgres
# On Railway: attach a Postgres service and reference its DATABASE_URL here
# via a shared variable ( ${{ Postgres.DATABASE_URL }} ).
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://user:pass@localhost:5432/license_server

# Set to "require" when connecting over a TLS endpoint (Railway PUBLIC proxy,
# Neon, Supabase, etc). Leave empty for Railway private networking / local Docker.
DATABASE_SSL=

# ---------------------------------------------------------------------------
# Admin web UI  ->  HTTP Basic auth on /admin
# ---------------------------------------------------------------------------
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-a-long-random-string

# ---------------------------------------------------------------------------
# Admin REST API  ->  Authorization: Bearer <token>
# Used by POST/GET/PATCH/DELETE /api/v1/licenses
# ---------------------------------------------------------------------------
ADMIN_API_TOKEN=change-me-to-a-long-random-string

# ---------------------------------------------------------------------------
# Ed25519 signing keys for entitlement tokens.
# Generate a pair with:  npm run keypair
#   - PRIVATE key stays here / in Railway env, never ships.
#   - PUBLIC key gets embedded into pos-app and POS-DUALSCREEN builds.
# Values are base64(DER): private = PKCS8, public = SPKI.
# ---------------------------------------------------------------------------
LICENSE_SIGNING_PRIVATE_KEY=
LICENSE_SIGNING_PUBLIC_KEY=

# How long an issued entitlement token stays valid (days). This is the
# offline budget: the desktop app keeps working with no internet until a
# cached token passes this age, then a short local grace, then it blocks.
LICENSE_TOKEN_TTL_DAYS=30
