{
  "name": "pos-app",
  "version": "0.1.0",
  "private": true,
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "npm run build:electron && concurrently -k -n NEXT,ELECTRON \"npm:dev:next\" \"npm:dev:electron\"",
    "dev:next": "next dev -p 3000",
    "dev:electron": "wait-on tcp:3000 && electron .",
    "build:electron": "tsc -p electron/tsconfig.json",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "package:win10": "npm run build && npm run build:electron && electron-builder --config electron-builder.win10.json",
    "package:win7": "npm run build && npm run build:electron && electron-builder --config electron-builder.win7.json"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "embedded-postgres": "^18.4.0-beta.17",
    "jose": "^6.2.10",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^1.34.0",
    "next": "16.3.2",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.8.0",
    "shadcn": "^4.19.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsbarcode": "^3.11.4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "wait-on": "^9.1.0"
  }
}
